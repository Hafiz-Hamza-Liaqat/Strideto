{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:seo",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.strideto.com/sitemap.xml" },
    { "source": "/indexnow-key.txt", "destination": "https://api.strideto.com/indexnow-key.txt" },
    { "source": "/tests", "destination": "/tests/index.html" },
    { "source": "/tests/compare", "destination": "/tests/compare/index.html" },
    { "source": "/tests/ielts", "destination": "/tests/ielts/index.html" },
    { "source": "/tests/toefl-ibt", "destination": "/tests/toefl-ibt/index.html" },
    { "source": "/tests/pte-academic", "destination": "/tests/pte-academic/index.html" },
    { "source": "/tests/duolingo-english-test", "destination": "/tests/duolingo-english-test/index.html" },
    { "source": "/tests/gre", "destination": "/tests/gre/index.html" },
    { "source": "/tests/gmat", "destination": "/tests/gmat/index.html" },
    { "source": "/jobs", "destination": "/jobs/index.html" },
    { "source": "/jobs/:slug", "destination": "/api/seo/jobs/:slug" },
    { "source": "/scholarships/:slug", "destination": "/api/seo/entity/scholarship/:slug" },
    { "source": "/blog/:slug", "destination": "/api/seo/entity/blog/:slug" },
    { "source": "/institutions/:slug", "destination": "/api/seo/entity/institution/:slug" },
    { "source": "/tests/:slug", "destination": "/api/seo/entity/test/:slug" },
    { "source": "/program-explorer/:slug", "destination": "/api/seo/entity/program/:slug" },
    { "source": "/exam-prep", "destination": "/exam-prep/index.html" },
    { "source": "/exam-prep/:path*", "destination": "/exam-prep/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/exam-prep",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/exam-prep/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/((?!assets/|.*\\.).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
