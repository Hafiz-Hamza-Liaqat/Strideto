# =============================================================================
# Strideto — Environment template (copy sections to the right files)
# NEVER commit real secrets. Copy this file to .env at repo root for Docker deploy.
# =============================================================================

# -----------------------------------------------------------------------------
# DOCKER / ROOT .env  (used by docker compose — copy this whole block to .env)
# -----------------------------------------------------------------------------
# Generate each secret with: openssl rand -hex 32
# The example strings below are not valid production secrets; validation rejects them.
JWT_SECRET=replace-with-openssl-rand-hex-32
REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-32
# Optional Cloudflare Turnstile (leave unset = not_configured; never commit production secrets)
# TURNSTILE_ENABLED=0
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_ENABLED=0
# VITE_TURNSTILE_SITE_KEY=
# Optional Google sign-in (leave unset = disabled; server-side only, never exposed to the client)
# OAUTH_GOOGLE_ENABLED=0
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Localhost goes through the Vite dev proxy so the refresh cookie host matches the SPA origin.
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/oauth/google/callback
SITE_URL=https://strideto.com
FRONTEND_URL=https://strideto.com
VITE_APP_URL=https://www.strideto.com
VITE_API_URL=/api
FRONTEND_PORT=80

# Optional: use MongoDB Atlas instead of container MongoDB
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/edurozgaar?retryWrites=true&w=majority

# Optional: disable government job scraper cron (1 = disabled)
# DISABLE_SCRAPER_CRON=0

# SMTP (transactional mail) — Brevo, Resend, Gmail, etc.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your-smtp-login
MAIL_PASS=your-smtp-password
MAIL_FROM=Strideto <noreply@strideto.com>
# User email verification (registration + resend) — dedicated SMTP boundary (never commit real values)
# VERIFICATION_MAIL_HOST=smtp.gmail.com
# VERIFICATION_MAIL_PORT=587
# VERIFICATION_MAIL_USER=your-verification-account@example.com
# VERIFICATION_MAIL_PASS=replace-with-app-password
# VERIFICATION_EMAIL_FROM=Strideto <your-verification-account@example.com>
# Or split visible From:
# VERIFICATION_EMAIL_FROM_NAME=Strideto
# VERIFICATION_EMAIL_FROM_ADDRESS=strideto@gmail.com
# Production requires VERIFICATION_MAIL_USER/PASS and VERIFICATION_EMAIL_FROM*. Password reset uses MAIL_* above.

# Stripe (employer job payments)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary (resume/application uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Media Library storage (C.7.0.1) — local | supabase | s3 (default: local)
# MEDIA_STORAGE_PROVIDER=local
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Optional: disable queue cron on API when worker container runs it
# DISABLE_QUEUE_CRON=1
# DISABLE_REMINDER_CRON=0
# WORKER_POLL_INTERVAL_MS=15000

# Logging & monitoring
# LOG_LEVEL=info
# SENTRY_DSN=

# MongoDB pool (production)
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=2

# Shutdown
# SHUTDOWN_TIMEOUT_MS=30000

# Client AdSense (build-time)
# VITE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxx
# ADMIN_EMAIL=admin@strideto.com
# ADMIN_PASSWORD=YourSecureAdminPassword123!

# -----------------------------------------------------------------------------
# SERVER — copy to server/.env for local npm run dev / PM2
# -----------------------------------------------------------------------------
# PORT=5000
# NODE_ENV=development
# MONGO_URI=mongodb://localhost:27017/edurozgaar
# JWT_SECRET=replace-with-openssl-rand-hex-32
# REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-32
# Access-token and refresh-session lifetimes are defined by the canonical
# secure-auth implementation (15 minutes and 7 days respectively).
# SITE_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# REDIS_URL=redis://localhost:6379
# DISABLE_SCRAPER_CRON=0
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=

# -----------------------------------------------------------------------------
# CLIENT — copy to client/.env for local Vite dev
# -----------------------------------------------------------------------------
# VITE_API_URL=http://localhost:5000/api
# VITE_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# CLIENT production build — copy to client/.env.production
# -----------------------------------------------------------------------------
# VITE_API_URL=/api
# VITE_APP_URL=https://www.strideto.com

# -----------------------------------------------------------------------------
# CAREER DOMAIN — TalentProfile rollout (C.8.0.2A)
# -----------------------------------------------------------------------------
# TALENT_PROFILE_ENABLED=1
# TALENT_PROFILE_DUAL_WRITE=0
# TALENT_PROFILE_READ_CANONICAL=0
# VITE_TALENT_PROFILE_ENABLED=1
# VITE_TALENT_PROFILE_READ_CANONICAL=0
# OPPORTUNITY_APPLICATION_ENABLED=1
# VITE_OPPORTUNITY_APPLICATION_ENABLED=1
# TIMELINE_ENABLED=1
# VITE_TIMELINE_ENABLED=1
# DOCUMENTS_PLATFORM_ENABLED=1
# VITE_DOCUMENTS_PLATFORM_ENABLED=1
# CAREER_DASHBOARD_ENABLED=1
# VITE_CAREER_DASHBOARD_ENABLED=1
# CAREER_DASHBOARD_V2_ENABLED=1
# VITE_CAREER_DASHBOARD_V2_ENABLED=1
# DASHBOARD_PERSONALIZATION_ENABLED=0
# VITE_DASHBOARD_PERSONALIZATION_ENABLED=0
# SCORING_ENABLED=1
# VITE_SCORING_ENABLED=1
# ASSESSMENTS_ENABLED=0
# VITE_ASSESSMENTS_ENABLED=0
# BUSINESS_SERVICES_ENABLED=0
# VITE_BUSINESS_SERVICES_ENABLED=0
# Provider workspace/onboarding (compat: BUSINESS_SERVICES_ENABLED=1 also enables workspace)
# BUSINESS_SERVICES_PROVIDER_ENABLED=0
# Public Business Services marketplace — committed default OFF.
# Local/test acceptance may set =1; never commit production/staging ON.
# BUSINESS_SERVICES_PUBLIC_MARKETPLACE_ENABLED=0
# Staged private workspace launch (Institution / Education & Mobility / Business).
# Safe defaults: unset or 0 = Coming Soon. Set =1 only after QA unlock.
# Student and Employer are always active — no WORKSPACE_LAUNCH_STUDENT/EMPLOYER flags.
# WORKSPACE_LAUNCH_INSTITUTION=0
# WORKSPACE_LAUNCH_EDUCATION_MOBILITY=0
# WORKSPACE_LAUNCH_BUSINESS_SERVICES=0
# VITE_WORKSPACE_LAUNCH_INSTITUTION=0
# VITE_WORKSPACE_LAUNCH_EDUCATION_MOBILITY=0
# VITE_WORKSPACE_LAUNCH_BUSINESS_SERVICES=0
# GBS HSI documents — committed default OFF. Flag ON never bypasses capability readiness.
# GBS_HSI_DOCUMENTS_ENABLED=0
# Filing authorization / external filing attestation — committed default OFF.
# Flags may disable only. They cannot activate the draft Wyoming pack or approve legal text.
# GBS_WYOMING_FORMATION_ENABLED=0
# GBS_FILING_AUTHORIZATION_ENABLED=0
# GBS_EXTERNAL_FILING_ATTESTATION_ENABLED=0
# CLAMAV_CLAMD_HOST=
# CLAMAV_CLAMD_PORT=3310
# HSI_MINIO_ENDPOINT=
# HSI_MINIO_ACCESS_KEY=
# HSI_MINIO_SECRET_KEY=
# HSI_MINIO_QUARANTINE_BUCKET=
# HSI_MINIO_CLEAN_BUCKET=
# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_TRANSIT_KEY_NAME=
# GBS_HSI_RETENTION_POLICY_JSON=
# ASSESSMENT_RESULTS_ENABLED=1
# VERIFIED_CREDENTIALS_ENABLED=1
# EMPLOYER_INTELLIGENCE_ENABLED=1
# VITE_EMPLOYER_INTELLIGENCE_ENABLED=1
# APPLICATION_DUAL_WRITE — unset = ON when Opportunity Applications enabled (L.2.6 Apply→Tracker).
# Set APPLICATION_DUAL_WRITE=0 to disable dual-write explicitly.
# APPLICATION_DUAL_WRITE=0
# APPLICATION_READ_CANONICAL=0
# VITE_APPLICATION_READ_CANONICAL=0
# DOCUMENTS_MIGRATION_ENABLED=1
# Paid AI — OFF for launch (docs/AI_BUDGET_POLICY.md). Do not set OPENAI_API_KEY / ANTHROPIC_API_KEY.
# CAREER_MIGRATION_JOBS_ENABLED=1
