# =============================================================================
# Strideto — Production environment checklist
# Copy values into Vercel (frontend) and Render/API host (backend).
# NEVER commit real secrets. This file is documentation only.
# =============================================================================

NODE_ENV=production
APP_ENV=production

# --- Public URLs ---
SITE_URL=https://strideto.com
FRONTEND_URL=https://strideto.com
CLIENT_URL=https://strideto.com
APP_URL=https://strideto.com
API_URL=https://api.strideto.com

# --- Frontend (Vercel build-time) ---
VITE_APP_URL=https://www.strideto.com
VITE_API_URL=https://api.strideto.com/api
# VITE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxx

# Career feature flags (keep client/server aligned)
VITE_TALENT_PROFILE_ENABLED=1
VITE_OPPORTUNITY_APPLICATION_ENABLED=1
VITE_TIMELINE_ENABLED=1
VITE_DOCUMENTS_PLATFORM_ENABLED=1
VITE_CAREER_DASHBOARD_ENABLED=1
VITE_CAREER_DASHBOARD_V2_ENABLED=1
VITE_DASHBOARD_PERSONALIZATION_ENABLED=0
VITE_SCORING_ENABLED=1
VITE_ASSESSMENTS_ENABLED=0
VITE_EMPLOYER_INTELLIGENCE_ENABLED=1
VITE_TALENT_PROFILE_READ_CANONICAL=0
VITE_APPLICATION_READ_CANONICAL=0

# --- Backend (Render / Node host) ---
# PORT is set by the host
# Generate each secret with: openssl rand -hex 32
# The example strings below are not valid production secrets; validation rejects them.
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_openssl_rand_hex_32
# Canonical lifetimes are source-controlled: 15-minute access tokens and
# 7-day refresh sessions/cookies.

MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/strideto?retryWrites=true&w=majority
# Legacy DB name still supported: .../edurozgaar

REDIS_URL=redis://USER:PASS@HOST:6379
REQUIRE_REDIS=1

# SMTP (Brevo / Resend / etc.)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Strideto <noreply@strideto.com>
# MAIL_SECURE=false
# CONTACT_ADMIN_EMAIL=support@strideto.com

# Email verification enforcement (ISO-8601). Accounts created before this remain usable without verify.
# AUTH_EMAIL_VERIFY_ENFORCE_FROM=2026-07-26T11:00:00.000Z

# Media — prefer object storage for production
MEDIA_STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_CDN_URL=https://cdn.strideto.com

# Worker / crons (API process)
DISABLE_QUEUE_CRON=1
DISABLE_REMINDER_CRON=1
CMS_SEED_ON_START=0
LOG_LEVEL=info
# SENTRY_DSN=

# Career flags (server)
TALENT_PROFILE_ENABLED=1
TALENT_PROFILE_DUAL_WRITE=0
OPPORTUNITY_APPLICATION_ENABLED=1
APPLICATION_DUAL_WRITE=0
TIMELINE_ENABLED=1
DOCUMENTS_PLATFORM_ENABLED=1
CAREER_DASHBOARD_ENABLED=1
CAREER_DASHBOARD_V2_ENABLED=1
DASHBOARD_PERSONALIZATION_ENABLED=0
SCORING_ENABLED=1
ASSESSMENTS_ENABLED=0
BUSINESS_SERVICES_ENABLED=0
BUSINESS_SERVICES_PUBLIC_MARKETPLACE_ENABLED=0
GBS_HSI_DOCUMENTS_ENABLED=0
GBS_WYOMING_FORMATION_ENABLED=0
GBS_FILING_AUTHORIZATION_ENABLED=0
GBS_EXTERNAL_FILING_ATTESTATION_ENABLED=0
EMPLOYER_INTELLIGENCE_ENABLED=1
CAREER_MIGRATION_JOBS_ENABLED=0

# Bootstrap admin (run once via ensureAdminUser.js — then rotate)
# ADMIN_EMAIL=admin@strideto.com
# ADMIN_PASSWORD=

# Paid AI — leave unset (AI Budget Policy)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
